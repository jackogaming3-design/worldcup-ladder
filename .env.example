# ----------------------------------------------------------------------------
# 2026 World Cup Live Ladder — environment variables
# Copy to ".env" for local use. On Render these are set in the dashboard /
# auto-injected by render.yaml. NEVER commit a real .env file.
# ----------------------------------------------------------------------------

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (Postgres) ---
# Render: auto-injected by the blueprint (render.yaml).
# Supabase / local: paste your full connection string here.
DATABASE_URL=postgres://user:password@host:5432/dbname
# SSL is auto-enabled for remote hosts and off for localhost. Override if needed:
# PGSSL=false

# --- API-Football (sign up at https://www.api-football.com) ---
API_FOOTBALL_KEY=your_api_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Header the key is sent in. Direct API-Sports = x-apisports-key. Via RapidAPI = x-rapidapi-key.
API_FOOTBALL_KEY_HEADER=x-apisports-key
WORLD_CUP_LEAGUE_ID=1
WORLD_CUP_SEASON=2026

# --- Admin / security ---
# Commissioner login password.
ADMIN_PASSWORD=choose_a_strong_password
# Bearer token the scheduled sync (cron / GitHub Action) uses to authenticate.
CRON_SECRET=long_random_string_for_cron_auth
# Signs the admin session cookie. Falls back to CRON_SECRET/ADMIN_PASSWORD if unset.
SESSION_SECRET=another_long_random_string
